# En Hostinger, para una base MySQL del mismo hosting, DB_HOST suele ser 127.0.0.1.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=usuario_mysql
DB_PASSWORD=clave_mysql
DB_NAME=nombre_base

# Alternativa: una única cadena de conexión (no usar junto con las variables anteriores).
# DATABASE_URL=mysql://usuario:clave@127.0.0.1:3306/nombre_base
